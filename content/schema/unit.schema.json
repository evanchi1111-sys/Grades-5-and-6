{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evanchi1111-sys.github.io/Grades-5-and-6/content/schema/unit.schema.json",
  "title": "學習冒險島 教材單元 (Unit)",
  "description": "教材中央資料庫的單一單元。所有匯入、審核、發布的資料都必須通過這個格式。unitId 是各模組取得教材的唯一鍵。",
  "type": "object",
  "required": ["schemaVersion", "unitId", "grade", "subject", "subjectName", "unitNumber", "unitTitle", "textbookVersion", "learningObjectives", "sourceFiles", "lessons", "keyPoints", "illustrations", "experiments", "examples", "questions", "assessments", "explanations", "commonMistakes", "achievements", "reviewStatus", "version", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "unitId": { "type": "string", "pattern": "^G(1[0-2]|[1-9])-[A-Z]{3,4}-U[0-9]{2}$", "description": "例：G5-NAT-U01（年級-科目代碼-單元）" },
    "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
    "subject": { "type": "string", "pattern": "^[A-Z]{3,4}$", "description": "科目代碼：CHI 國語、MAT 數學、SOC 社會、NAT 自然，未來可新增" },
    "subjectName": { "type": "string", "minLength": 1 },
    "unitNumber": { "type": "integer", "minimum": 1 },
    "unitTitle": { "type": "string", "minLength": 1 },
    "textbookVersion": { "type": "string", "minLength": 1, "description": "課本出版社與版本；不知道時填「未標示」，不可猜測" },
    "learningObjectives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sourceFiles": { "type": "array", "items": { "$ref": "#/$defs/sourceFile" } },
    "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } },
    "keyPoints": { "type": "array", "items": { "$ref": "#/$defs/keyPoint" } },
    "illustrations": { "type": "array", "items": { "$ref": "#/$defs/illustration" } },
    "experiments": { "type": "array", "items": { "$ref": "#/$defs/experiment" } },
    "examples": { "type": "array", "items": { "$ref": "#/$defs/example" } },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "assessments": { "type": "array", "items": { "$ref": "#/$defs/assessment" } },
    "explanations": { "type": "array", "items": { "$ref": "#/$defs/explanation" } },
    "commonMistakes": { "type": "array", "items": { "$ref": "#/$defs/commonMistake" } },
    "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
    "reviewStatus": { "enum": ["draft", "parsing", "pending_review", "approved", "published", "archived"], "description": "單元生命週期狀態" },
    "version": { "$ref": "#/$defs/version" },
    "createdAt": { "type": "string", "minLength": 10 },
    "updatedAt": { "type": "string", "minLength": 10 },
    "extensions": { "type": "object", "description": "保留給未來擴充（例如各科專屬欄位）" }
  },
  "$defs": {
    "itemReview": { "enum": ["pending", "approved", "rejected", "needs_confirmation"], "description": "單項內容的審核狀態；needs_confirmation＝待人工確認（解析器無法辨識，不可當成確定內容）" },
    "source": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "fileId": { "type": "string" },
        "fileName": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "locator": { "type": "string", "description": "原始段落位置，例如「第 2 段」「表 3」「投影片 5 標題下」" },
        "legacyRef": { "type": "string", "description": "對應既有頁面或節點，例如 island.html#a2" }
      }
    },
    "sourceFile": {
      "type": "object", "additionalProperties": false,
      "required": ["fileId", "fileName", "mimeType", "sizeBytes", "sha256", "role", "uploadedAt"],
      "properties": {
        "fileId": { "type": "string", "minLength": 1 }, "fileName": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string" }, "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["original", "supplement", "image", "attachment", "legacy"] },
        "uploadedAt": { "type": "string" }, "storagePath": { "type": "string", "description": "原始檔在儲存空間的位置（靜態階段為 repo 內路徑，後端階段為物件儲存路徑）" },
        "parser": { "type": "string", "description": "處理這個檔案的 parser adapter 名稱與版本" }
      }
    },
    "lesson": {
      "type": "object", "additionalProperties": false, "required": ["lessonId", "title", "order", "source", "reviewStatus"],
      "properties": {
        "lessonId": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 1 },
        "blocks": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["text", "list", "table", "image", "note"] }, "text": { "type": "string" }, "items": { "type": "array", "items": { "type": "string" } }, "illustrationId": { "type": "string" }, "rows": { "type": "array" } } }, "description": "教材內容區塊；既有教材可改用 ref 指向原頁面，避免複製" },
        "ref": { "type": "object", "additionalProperties": false, "properties": { "page": { "type": "string" }, "nodeId": { "type": "string" } }, "description": "引用既有教材頁面的節點（唯讀）" },
        "keyPointIds": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/source" }, "reviewStatus": { "$ref": "#/$defs/itemReview" }
      }
    },
    "keyPoint": {
      "type": "object", "additionalProperties": false, "required": ["knowledgePointId", "text", "source", "reviewStatus"],
      "properties": { "knowledgePointId": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "lessonId": { "type": "string" },
        "remedy": { "type": "object", "additionalProperties": false, "properties": { "type": { "enum": ["lesson", "experiment"] }, "targetId": { "type": "string" } }, "description": "答錯時要連回的教材或互動實驗" },
        "source": { "$ref": "#/$defs/source" }, "reviewStatus": { "$ref": "#/$defs/itemReview" } }
    },
    "illustration": {
      "type": "object", "additionalProperties": false, "required": ["illustrationId", "caption", "alt", "source", "reviewStatus"],
      "properties": { "illustrationId": { "type": "string", "minLength": 1 }, "caption": { "type": "string" }, "alt": { "type": "string", "minLength": 1 }, "fileId": { "type": "string" },
        "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "圖片在原頁面的位置 [x, y, 寬, 高]（0～1 的比例）" },
        "credit": { "type": "string" }, "source": { "$ref": "#/$defs/source" }, "reviewStatus": { "$ref": "#/$defs/itemReview" } }
    },
    "experiment": {
      "type": "object", "additionalProperties": false, "required": ["experimentId", "title", "objective", "steps", "safety", "source", "reviewStatus"],
      "properties": { "experimentId": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "objective": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } }, "conditions": { "type": "array", "items": { "type": "string" } },
        "observe": { "type": "array", "items": { "type": "string" } }, "principle": { "type": "string" }, "conclusion": { "type": "string" },
        "safety": { "type": "string" }, "modelAssumptions": { "type": "array", "items": { "type": "string" } }, "modelLimits": { "type": "array", "items": { "type": "string" } },
        "activityRef": { "type": "string", "description": "對應的互動模擬模組，例如 science/activities/sun-shadow.js；沒有就只顯示文字版實驗" },
        "source": { "$ref": "#/$defs/source" }, "reviewStatus": { "$ref": "#/$defs/itemReview" } }
    },
    "example": {
      "type": "object", "additionalProperties": false, "required": ["exampleId", "title", "problem", "steps", "source", "reviewStatus"],
      "properties": { "exampleId": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "kind": { "type": "string" }, "problem": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } }, "source": { "$ref": "#/$defs/source" }, "reviewStatus": { "$ref": "#/$defs/itemReview" } }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["questionId", "unitId", "knowledgePointId", "questionType", "difficulty", "questionText", "correctAnswer", "explanation", "sourceFile", "sourcePage", "reviewStatus"],
      "properties": {
        "questionId": { "type": "string", "pattern": "^G(1[0-2]|[1-9])-[A-Z]{3,4}-U[0-9]{2}-Q[0-9]{3,}$" },
        "unitId": { "type": "string", "pattern": "^G(1[0-2]|[1-9])-[A-Z]{3,4}-U[0-9]{2}$" },
        "knowledgePointId": { "type": "string", "minLength": 1 },
        "questionType": { "enum": ["mc", "tf", "match", "fill", "short", "order", "sort"], "description": "選擇、是非、配合、填充、簡答；另加 order 排序、sort 分類（既有題庫使用，為了完整容納而擴充）" },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 3, "description": "1 基礎、2 進階、3 精熟" },
        "questionText": { "type": "string", "minLength": 1 },
        "options": { "type": ["array", "object"], "description": "mc：選項文字；tf 可省略；fill：可選的詞庫；sort：{buckets:[分類名], items:[項目]}" },
        "table": { "type": "object", "description": "題目附帶的表格 {h:[欄位], r:[[列]]}" },
        "answerAnyOrder": { "type": "boolean", "description": "fill：多個空格的答案可以不按順序" },
        "correctAnswer": { "description": "mc：選項索引（整數）；tf：true/false；fill：依序的答案陣列；match：[左,右] 配對陣列；short：{reference, keywords}（需老師評分）；order：正確順序的項目陣列；sort：每個項目所屬分類的索引陣列（options.buckets／options.items）" },
        "explanation": { "type": "string" },
        "sourceFile": { "type": "string", "description": "來源檔名（或 fileId）" },
        "sourcePage": { "type": ["integer", "null"], "description": "來源頁碼；無法得知時為 null，並將 reviewStatus 設為 needs_confirmation" },
        "revision": { "type": "integer", "minimum": 1, "description": "題目被修改的次數；questionId 永遠不變" },
        "legacyRef": { "type": "string", "description": "對應既有題庫（例如 index.html?u=20 的題目 id）；既有題目不被複製或覆蓋" },
        "reviewStatus": { "$ref": "#/$defs/itemReview" }
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false, "required": ["assessmentId", "title", "questionIds"],
      "properties": { "assessmentId": { "type": "string" }, "title": { "type": "string" }, "questionIds": { "type": "array", "items": { "type": "string" } },
        "total": { "type": "integer", "minimum": 1 }, "perLevel": { "type": "object" }, "passPercent": { "type": "integer", "minimum": 0, "maximum": 100 } }
    },
    "explanation": {
      "type": "object", "additionalProperties": false, "required": ["explanationId", "knowledgePointId", "text", "source", "reviewStatus"],
      "properties": { "explanationId": { "type": "string" }, "knowledgePointId": { "type": "string" }, "text": { "type": "string" }, "source": { "$ref": "#/$defs/source" }, "reviewStatus": { "$ref": "#/$defs/itemReview" } }
    },
    "commonMistake": {
      "type": "object", "additionalProperties": false, "required": ["mistakeId", "text", "source", "reviewStatus"],
      "properties": { "mistakeId": { "type": "string" }, "text": { "type": "string", "minLength": 1 }, "knowledgePointId": { "type": "string" }, "source": { "$ref": "#/$defs/source" }, "reviewStatus": { "$ref": "#/$defs/itemReview" } }
    },
    "achievement": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "desc", "rule"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "desc": { "type": "string" }, "icon": { "type": "string" },
        "rule": { "type": "object", "description": "{lab:實驗id}｜{test:百分比}｜{clear:true}" } }
    },
    "version": {
      "type": "object", "additionalProperties": false, "required": ["number", "createdAt", "summary", "author"],
      "properties": { "number": { "type": "integer", "minimum": 1 }, "createdAt": { "type": "string" }, "summary": { "type": "string", "minLength": 1, "description": "修改摘要" },
        "author": { "type": "string", "minLength": 1 }, "reviewer": { "type": ["string", "null"] }, "reviewedAt": { "type": ["string", "null"] },
        "selfReview": { "type": "boolean", "description": "審核者與作者是同一人（自我審查）" },
        "parentVersion": { "type": ["integer", "null"], "description": "這一版是從哪一版修改而來" }, "publishedAt": { "type": ["string", "null"] } }
    }
  }
}
